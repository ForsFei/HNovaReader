<UserControl x:Class="HNovaReader.Features.Library.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:library="clr-namespace:HNovaReader.Features.Library"
             mc:Ignorable="d">
    <UserControl.Resources>
        <library:CoverImageConverter x:Key="CoverImageConverter" />


        <ContextMenu x:Key="BookContextMenu"
                     x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Style="{StaticResource HNova.ContextMenu}">
            <ContextMenu.Resources>
                <Style BasedOn="{StaticResource HNova.MenuItem}" TargetType="MenuItem" />
                <Style BasedOn="{StaticResource HNova.MenuSeparator}" TargetType="Separator" />
            </ContextMenu.Resources>
            <MenuItem Command="{Binding OpenCommand}" Header="{Binding PrimaryActionText}" />
            <MenuItem Command="{Binding ToggleFavoriteCommand}" Header="{Binding FavoriteActionText}" />
            <Separator />
            <MenuItem Command="{Binding EditCommand}" Header="编辑书籍信息" />
            <MenuItem Command="{Binding ChangeCoverCommand}" Header="修改封面" />
            <Separator />
            <MenuItem Command="{Binding RevealFileCommand}" Header="打开文件所在位置" />
            <MenuItem Command="{Binding RefreshFileInfoCommand}" Header="重新读取文件信息" />
            <MenuItem Command="{Binding RelocateFileCommand}" Header="重新定位文件" />
            <Separator />
            <MenuItem Command="{Binding RemoveCommand}" Header="从书库移除" />
            <MenuItem Command="{Binding DeleteFileCommand}"
                      Foreground="{DynamicResource DangerBrush}"
                      Header="删除磁盘文件" />
        </ContextMenu>

        <DataTemplate x:Key="CoverTemplate">
            <Grid ClipToBounds="True">
                <Border Background="{DynamicResource AccentBrush}"
                        CornerRadius="7"
                        Opacity="{Binding AccentOpacity}" />
                <Grid>
                    <Path Width="110"
                          Height="110"
                          Margin="0,-34,-34,0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Data="M 55,0 A 55,55 0 1 1 54.9,0"
                          Fill="{DynamicResource FocusBrush}"
                          Stretch="Fill" />
                    <StackPanel Margin="14" VerticalAlignment="Bottom">
                        <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                   Text="{Binding CoverInitials}" />
                        <Border Width="28"
                                Height="2"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentForegroundBrush}" />
                    </StackPanel>
                </Grid>
                <Image Source="{Binding Details.CoverPath, Converter={StaticResource CoverImageConverter}}"
                       Stretch="UniformToFill">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCustomCover}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BookCardTemplate">
            <Border x:Name="Card"
                    MaxWidth="218"
                    Margin="7,7,7,13"
                    Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    ContextMenu="{StaticResource BookContextMenu}"
                    CornerRadius="11"
                    PreviewMouseLeftButtonDown="OnBookPointerDown"
                    PreviewMouseMove="OnBookPointerMove">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="210" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="7">
                        <Grid>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CoverTemplate}" />
                            <Border x:Name="HoverActions"
                                    Padding="8"
                                    VerticalAlignment="Bottom"
                                    Background="#CC0B0D10"
                                    CornerRadius="0,0,7,7"
                                    Opacity="0">
                                <Grid>
                                    <Button HorizontalAlignment="Left"
                                            Command="{Binding OpenCommand}"
                                            Content="{Binding PrimaryActionText}"
                                            Foreground="White"
                                            Style="{StaticResource HNova.ButtonBase}" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button Width="38"
                                                Height="38"
                                                Command="{Binding ToggleFavoriteCommand}"
                                                Content="{Binding FavoriteGlyph}"
                                                FontFamily="Segoe UI Symbol"
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                ToolTip="{Binding FavoriteActionText}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource HNova.IconButton}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="#DCE3EA" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Details.IsFavorite}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource FavoriteBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Width="32"
                                                Height="32"
                                                Margin="4,0,0,0"
                                                Content="•••"
                                                ContextMenu="{StaticResource BookContextMenu}"
                                                Click="OnMoreClick"
                                                Foreground="White"
                                                Style="{StaticResource HNova.IconButton}"
                                                ToolTip="更多操作" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Margin="8"
                                    Padding="7,3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource DangerBrush}"
                                    CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFileMissing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="文件丢失" />
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Margin="1,11,1,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Title}" />
                    <TextBlock Grid.Row="2"
                               Margin="1,4,1,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Author}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource FocusBrush}" />
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="HoverActions" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="38,30,38,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource HNova.PageTitle}" Text="{Binding SectionTitle}" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource HNova.PageDescription}"
                           Text="{Binding SectionDescription}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        Command="{Binding BackToGroupsCommand}"
                        Content="← 返回分组">
                    <Button.Style>
                        <Style BasedOn="{StaticResource HNova.SecondaryButton}" TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsGroupSection}" Value="True" />
                                        <Condition Binding="{Binding IsBookCollectionVisible}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding DataContext.ImportTextFilesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="＋  导入 TXT"
                        Style="{StaticResource HNova.PrimaryButton}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               IsHitTestVisible="False"
                               Text="搜索书名、作者、系列或标签">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock Grid.Column="1"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis" />

                <Border Grid.Column="1"
                        Margin="16,0"
                        Padding="9,4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{DynamicResource FocusBrush}"
                        CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedBooks}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource AccentBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="{Binding SelectedBookCount, StringFormat=已选择 {0} 本}" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding RefreshCommand}"
                            Content="↻  更新书库"
                            Style="{StaticResource HNova.SecondaryButton}"
                            ToolTip="扫描本地书库文件夹，同步新增和删除的 TXT" />
                    <Button Margin="8,0,0,0" Command="{Binding ShowGridCommand}" Content="▦">
                        <Button.Style>
                            <Style BasedOn="{StaticResource HNova.IconButton}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource FocusBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Margin="5,0,0,0" Command="{Binding ShowListCommand}" Content="☷">
                        <Button.Style>
                            <Style BasedOn="{StaticResource HNova.IconButton}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListView}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource FocusBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="4">
            <ListBox ItemsSource="{Binding BookRows}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsGridView}" Value="True" />
                                    <Condition Binding="{Binding IsBookCollectionVisible}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Books}" ItemTemplate="{StaticResource BookCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListView ItemsSource="{Binding Books}"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      SelectionMode="Extended"
                      MouseDoubleClick="OnBookDoubleClick"
                      PreviewMouseLeftButtonDown="OnBookPointerDown"
                      PreviewMouseMove="OnBookPointerMove"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.Style>
                    <Style TargetType="ListView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsListView}" Value="True" />
                                    <Condition Binding="{Binding IsBookCollectionVisible}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="ContextMenu" Value="{StaticResource BookContextMenu}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="5" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Width="58" Header="封面">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="34" Height="48" CornerRadius="4">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CoverTemplate}" />
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="190" DisplayMemberBinding="{Binding Title}" Header="书名" />
                        <GridViewColumn Width="130" DisplayMemberBinding="{Binding Author}" Header="作者" />
                        <GridViewColumn Width="150" DisplayMemberBinding="{Binding Series}" Header="系列" />
                        <GridViewColumn Width="190" DisplayMemberBinding="{Binding Tags}" Header="标签" />
                        <GridViewColumn Width="90" DisplayMemberBinding="{Binding FileSize}" Header="文件大小" />
                        <GridViewColumn Width="90" DisplayMemberBinding="{Binding FileAvailability}" Header="文件状态" />
                        <GridViewColumn Width="140" DisplayMemberBinding="{Binding LastOpened}" Header="最后打开" />
                    </GridView>
                </ListView.View>
            </ListView>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGroupOverviewVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="260"
                                    Height="106"
                                    Margin="0,0,14,14"
                                    Padding="18"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Command="{Binding DataContext.OpenGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource HNova.SecondaryButton}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,7,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding Count, StringFormat={}{0} 本书}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="20"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Text="→" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasVisibleBooks}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="58"
                        Height="58"
                        Background="{DynamicResource FocusBrush}"
                        CornerRadius="29">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="24"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="▦" />
                </Border>
                <TextBlock Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Text="没有可显示的书籍" />
                <TextBlock MaxWidth="460"
                           Margin="0,7,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding EmptyMessage}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <ProgressBar Height="2"
                         VerticalAlignment="Top"
                         IsIndeterminate="True">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </Grid>

        <TextBlock Grid.Row="5"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Right"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Text="提示：右键书籍可编辑信息、管理文件或移出书库" />
    </Grid>
</UserControl>
