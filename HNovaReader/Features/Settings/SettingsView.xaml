<UserControl x:Class="HNovaReader.Features.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="clr-namespace:HNovaReader.Data.Entities"
             xmlns:preferences="clr-namespace:HNovaReader.Services.Settings"
             xmlns:theming="clr-namespace:HNovaReader.Services.Theming"
             Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,30" MaxWidth="1080" HorizontalAlignment="Stretch" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource HNova.PageTitle}" Text="{Binding Title}" />
                <TextBlock Margin="0,7,0,0"
                           Style="{StaticResource HNova.PageDescription}"
                           Text="{Binding Description}" />
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource HNova.Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="应用主题" />
                        <TextBlock Margin="0,7,16,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding SelectedThemeDisplay, StringFormat=当前：{0}}" />
                    </StackPanel>
                    <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource HNova.SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <Button
                                Command="{Binding ApplyThemeCommand}"
                                CommandParameter="{x:Static theming:AppTheme.Dark}"
                                Content="深色"
                                >
                            <Button.Style><Style BasedOn="{StaticResource HNova.Segment}" TargetType="Button">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedTheme}" Value="{x:Static theming:AppTheme.Dark}"><Setter Property="Tag" Value="True" /></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button
                                Command="{Binding ApplyThemeCommand}"
                                CommandParameter="{x:Static theming:AppTheme.Light}"
                                Content="浅色"
                                >
                            <Button.Style><Style BasedOn="{StaticResource HNova.Segment}" TargetType="Button">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedTheme}" Value="{x:Static theming:AppTheme.Light}"><Setter Property="Tag" Value="True" /></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button Command="{Binding ApplyThemeCommand}"
                                CommandParameter="{x:Static theming:AppTheme.System}"
                                Content="跟随系统"
                                >
                            <Button.Style><Style BasedOn="{StaticResource HNova.Segment}" TargetType="Button">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedTheme}" Value="{x:Static theming:AppTheme.System}"><Setter Property="Tag" Value="True" /></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource HNova.Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="阅读器外观" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="阅读主题" />
                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              SelectedValue="{Binding SelectedReaderTheme}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="浅色" Tag="{x:Static preferences:ReaderTheme.Light}" />
                        <ComboBoxItem Content="深色" Tag="{x:Static preferences:ReaderTheme.Dark}" />
                        <ComboBoxItem Content="Sepia / 护眼" Tag="{x:Static preferences:ReaderTheme.Sepia}" />
                    </ComboBox>
                    <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Text="阅读模式" />
                    <ComboBox Grid.Row="2"
                              Grid.Column="4"
                              SelectedValue="{Binding SelectedReadingMode}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="连续滚动" Tag="{x:Static preferences:ReadingModePreference.Scroll}" />
                        <ComboBoxItem Content="分页阅读" Tag="{x:Static preferences:ReadingModePreference.Paged}" />
                    </ComboBox>

                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="字体" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ReaderFontFamily}" />
                    <TextBlock Grid.Row="4" Grid.Column="3" VerticalAlignment="Center" Text="字号 / 行距" />
                    <Grid Grid.Row="4" Grid.Column="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ReaderFontSize}" ToolTip="14–30" />
                        <TextBox Grid.Column="2" Text="{Binding ReaderLineHeight}" ToolTip="1.2–2.4" />
                    </Grid>

                    <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="段距 / 最大宽度" />
                    <Grid Grid.Row="6" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ReaderParagraphSpacing}" ToolTip="段落间距" />
                        <TextBox Grid.Column="2" Text="{Binding ReaderMaximumContentWidth}" ToolTip="正文最大宽度" />
                    </Grid>
                    <TextBlock Grid.Row="6" Grid.Column="3" VerticalAlignment="Center" Text="左右边距" />
                    <TextBox Grid.Row="6" Grid.Column="4" Text="{Binding ReaderHorizontalMargin}" ToolTip="24–160" />
                </Grid>
            </Border>

            <Border Grid.Row="6" Style="{StaticResource HNova.Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="导入与书库更新" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="导入行为" />
                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              SelectedValue="{Binding SelectedImportBehavior}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="保留原位置" Tag="{x:Static data:BookStorageMode.OriginalLocation}" />
                        <ComboBoxItem Content="复制到书库" Tag="{x:Static data:BookStorageMode.ManagedCopy}" />
                    </ComboBox>
                    <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Text="默认文本编码" />
                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding DefaultTextEncoding}" />
                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="管理型书库文件夹" />
                    <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding LibraryFolder}"
                                 ToolTip="留空时使用应用默认 library 目录" />
                        <Button Grid.Column="2"
                                Command="{Binding BrowseLibraryFolderCommand}"
                                Content="浏览…"
                                Style="{StaticResource HNova.SecondaryButton}" />
                    </Grid>
                    <CheckBox Grid.Row="4"
                              Grid.Column="4"
                              VerticalAlignment="Center"
                              Content="记住窗口大小"
                              IsChecked="{Binding RememberWindowSize}" />
                    <StackPanel Grid.Row="6" Grid.ColumnSpan="5">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox VerticalAlignment="Center" Content="自动定期更新书库"
                                      IsChecked="{Binding AutoUpdateLibrary}" />
                            <TextBlock Margin="20,0,8,0" VerticalAlignment="Center" Text="每隔" />
                            <TextBox Width="68" IsEnabled="{Binding AutoUpdateLibrary}"
                                     Text="{Binding LibraryUpdateIntervalMinutes}" ToolTip="1–1440 分钟" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="分钟" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" FontSize="11"
                                   Text="程序运行时扫描书库根目录，自动导入新增 TXT、移除已删除文件的书库记录；备份文件夹不会参与更新。" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="8">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding StatusMessage}" />
                <Button HorizontalAlignment="Right"
                        Command="{Binding SaveCommand}"
                        Content="保存设置"
                        Style="{StaticResource HNova.PrimaryButton}" />
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
